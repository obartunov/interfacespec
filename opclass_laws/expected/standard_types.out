-- text under several collations; the sample is the same, the laws are
-- per (opclass, collation)
CREATE TEMP TABLE words(w text);
INSERT INTO words VALUES (''), ('a'), ('A'), ('b'), ('B'), ('ab'), ('Ab'),
  ('a b'), ('1'), ('10'), ('9'), ('Straße'), ('STRASSE'), ('strasse'),
  (U&'\00E9'), (U&'e\0301'), ('e'), ('f');
CREATE COLLATION ci (provider = icu, locale = 'und-u-ks-level2', deterministic = false);
SELECT 'C' AS coll, law, status, detail FROM opclass_laws_check('text_ops',
  (SELECT array_agg(w COLLATE "C") FROM words));
 coll |                   law                    | status |        detail        
------+------------------------------------------+--------+----------------------
 C    | O1 cmp reflexive                         | pass   | 
 C    | O2 cmp antisymmetric                     | pass   | 
 C    | O3 cmp transitive                        | pass   | 
 C    | O4 operators agree with cmp              | pass   | 
 C    | O5 sortsupport agrees with cmp           | pass   | 
 C    | O6 abbreviated key agrees with cmp       | pass   | 
 C    | O7 equalimage: cmp-equal <=> image-equal | pass   | 
 C    | O9 skip support                          | n/a    | no skip support proc
(8 rows)

SELECT 'und-x-icu' AS coll, law, status, detail FROM opclass_laws_check('text_ops',
  (SELECT array_agg(w COLLATE "und-x-icu") FROM words));
   coll    |                   law                    | status |        detail        
-----------+------------------------------------------+--------+----------------------
 und-x-icu | O1 cmp reflexive                         | pass   | 
 und-x-icu | O2 cmp antisymmetric                     | pass   | 
 und-x-icu | O3 cmp transitive                        | pass   | 
 und-x-icu | O4 operators agree with cmp              | pass   | 
