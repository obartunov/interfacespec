-- Opclass laws for built-in btree opclasses on edge-value samples.
CREATE EXTENSION IF NOT EXISTS opclass_laws;
SELECT law, status, checked, detail FROM opclass_laws_check('int2_ops',
  '{-32768,-1,0,1,2,32767}'::int2[]);
                   law                    | status | checked |            detail             
------------------------------------------+--------+---------+-------------------------------
 O1 cmp reflexive                         | pass   |       6 | 
 O2 cmp antisymmetric                     | pass   |      15 | 
 O3 cmp transitive                        | pass   |     126 | 
 O4 operators agree with cmp              | pass   |     180 | 
 O5 sortsupport agrees with cmp           | pass   |      36 | 
 O6 abbreviated key agrees with cmp       | n/a    |       0 | opclass declined abbreviation
 O7 equalimage: cmp-equal <=> image-equal | pass   |      15 | 
 O9 skip support                          | pass   |       8 | 
(8 rows)

SELECT law, status, checked, detail FROM opclass_laws_check('int8_ops',
  '{-9223372036854775808,-1,0,1,2,9223372036854775807}'::int8[]);
                   law                    | status | checked |            detail             
------------------------------------------+--------+---------+-------------------------------
 O1 cmp reflexive                         | pass   |       6 | 
 O2 cmp antisymmetric                     | pass   |      15 | 
 O3 cmp transitive                        | pass   |     126 | 
 O4 operators agree with cmp              | pass   |     180 | 
 O5 sortsupport agrees with cmp           | pass   |      36 | 
 O6 abbreviated key agrees with cmp       | n/a    |       0 | opclass declined abbreviation
 O7 equalimage: cmp-equal <=> image-equal | pass   |      15 | 
 O9 skip support                          | pass   |       8 | 
(8 rows)

-- in_range across int2/int4/int8 offsets; base +/- offset overflows at the edges
SELECT law, status, checked, detail FROM opclass_laws_check_inrange('int4_ops',
  '{-2147483648,-5,-1,0,1,5,2147483647}'::int4[], '{0,1,32767}');
                  law                   | status | checked | detail 
----------------------------------------+--------+---------+--------
 O8 in_range monotone (bigint offset)   | pass   |    4116 | 
 O8 in_range monotone (smallint offset) | pass   |    4116 | 
 O8 in_range monotone (integer offset)  | pass   |    4116 | 
(3 rows)

SELECT law, status, checked, detail FROM opclass_laws_check('bool_ops', '{false,true}'::bool[]);
                   law                    | status | checked |       detail        
------------------------------------------+--------+---------+---------------------
 O1 cmp reflexive                         | pass   |       2 | 
 O2 cmp antisymmetric                     | pass   |       1 | 
 O3 cmp transitive                        | pass   |       6 | 
 O4 operators agree with cmp              | pass   |      20 | 
 O5 sortsupport agrees with cmp           | n/a    |       0 | no sortsupport proc
 O6 abbreviated key agrees with cmp       | n/a    |       0 | no sortsupport proc
 O7 equalimage: cmp-equal <=> image-equal | pass   |       1 | 
 O9 skip support                          | pass   |       4 | 
(8 rows)

SELECT law, status, checked, detail FROM opclass_laws_check('float8_ops',
  '{-Infinity,-1.5,-0,0,1e-300,1,Infinity,NaN}'::float8[]);
                   law                    | status | checked |                                     detail                                      
------------------------------------------+--------+---------+---------------------------------------------------------------------------------
 O1 cmp reflexive                         | pass   |       8 | 
 O2 cmp antisymmetric                     | pass   |      28 | 
 O3 cmp transitive                        | pass   |     296 | 
 O4 operators agree with cmp              | pass   |     320 | 
 O5 sortsupport agrees with cmp           | pass   |      64 | 
 O6 abbreviated key agrees with cmp       | n/a    |       0 | opclass declined abbreviation
 O7 equalimage: cmp-equal <=> image-equal | n/a    |      28 | no equalimage proc; sample has 1 cmp-equal image-different pairs, e.g. a=-0 b=0
 O9 skip support                          | n/a    |       0 | no skip support proc
(8 rows)

SELECT law, status, checked, detail FROM opclass_laws_check_inrange('float8_ops',
  '{-Infinity,-1.5,-0,0,1,Infinity,NaN}'::float8[], '{0,1,Infinity}');
                      law                       | status | checked | detail 
------------------------------------------------+--------+---------+--------
 O8 in_range monotone (double precision offset) | pass   |    4116 | 
(1 row)

